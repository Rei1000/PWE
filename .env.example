DATABASE_URL=
# Leer lassen für In-Memory (Dev/Test). Beispiele:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
# docker compose setzt DATABASE_URL automatisch und migriert im Entrypoint (Gate 7.5).
# Ohne Docker: vor dem Backend-Start `cd backend && alembic upgrade head`
API_URL=
ENV=development

# Externes Kommando — Adapterwahl (Default: simulation)
# EXTERNES_KOMMANDO_ADAPTER=simulation
# EXTERNES_KOMMANDO_ADAPTER=com
# SERIELL_PORT=/dev/ttyUSB0
# SERIELL_BAUDRATE=9600
# SERIELL_TIMEOUT_MS=3000
# COM-Modus erfordert: pip install ".[com]" (pyserial)

# Gate 6.3c — Demo-/Labor-Simulation (Default: deaktiviert)
# Nur bei true und Adapter=simulation: feste Antwort für DEMO_MESSWERT.
# Niemals in Produktion aktivieren.
PWE_DEMO_MODE=false

# Gate 8.1a — Seed-Administrator (Default nur in Development/Demo)
# PWE_SEED_ADMIN=true
# PWE_SEED_ADMIN_LOGIN=admin
# PWE_SEED_ADMIN_NAME=Administrator
# PWE_SEED_ADMIN_PASSWORD=  # Pflicht außerhalb ENV=development|dev|test / PWE_DEMO_MODE
# PWE_ALLOW_DEFAULT_ADMIN_PASSWORD=false
# PWE_COOKIE_SECURE=false
# PWE_COOKIE_SAMESITE=lax
# PWE_SESSION_IDLE_MINUTES=60
# PWE_SESSION_ABSOLUTE_HOURS=12

# Gate 8.3a — Datei-Storage für Foto-Nachweise (Default: In-Memory ohne gesetzten Pfad)
# PWE_DATEI_STORAGE_PFAD=/var/pwe/dateien
# Docker Compose setzt PWE_DATEI_STORAGE_PFAD und Volume automatisch.
